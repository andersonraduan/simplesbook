# SimplesBook - Configuração para cPanel com Passenger

# ============================================
# CONFIGURAÇÃO PASSENGER (cPanel)
# ============================================

# Habilitar Passenger
PassengerEnabled On

# Tipo de aplicação
PassengerAppType node

# Arquivo de inicialização
PassengerStartupFile app.js

# AJUSTE ESTE CAMINHO para o seu usuário e domínio:
# Exemplo: /home/clini489/calendario.clinicalasante.pt
PassengerAppRoot /home/SEU_USUARIO/SEU_DOMINIO

# AJUSTE ESTE CAMINHO para o Node.js correto:
# Para descobrir, execute no servidor: which node
# Exemplo: /home/clini489/nodevenv/calendario.clinicalasante.pt/20/bin/node
PassengerNodejs /home/SEU_USUARIO/nodevenv/SEU_DOMINIO/20/bin/node

# Variáveis de ambiente
SetEnv NODE_ENV production

# ============================================
# REDIRECIONAMENTO HTTPS
# ============================================

RewriteEngine On

# Redirecionar HTTP para HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# HEADERS DE SEGURANÇA
# ============================================

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "origin-when-cross-origin"
    
    # HSTS (descomentar após confirmar que HTTPS funciona)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ============================================
# COMPRESSÃO E CACHE
# ============================================

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache para assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

